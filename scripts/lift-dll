#!/bin/bash
# Usage: scripts/lift-dll <module-name> <dll> <runtime-base>
set -euo pipefail
cd "$(dirname "$0")/.."
if [[ $# != 3 || ! $1 =~ ^[a-zA-Z0-9_]+$ || $1 == smr ]]; then
    echo 'Usage: lift-dll <module-name> <dll> <runtime-base>' >&2
    exit 2
fi
name=$1
project="$PWD/work/ghidra-$name"
output="$PWD/work/$name-generated"
if [[ -e "$output" && ! -f "$output/lifted-dll" ]]; then
    echo "Existing output belongs to another build: $output" >&2
    exit 2
fi
mkdir -p "$project"
python="$PWD/.venv/bin/python"
dll="$project/$(basename "$2")"
"$python" tools/recomp/relocate_pe.py "$2" "$3" "$dll"
export JAVA_HOME="$(brew --prefix openjdk@25)/libexec/openjdk.jdk/Contents/Home"
headless="$(brew --prefix ghidra)/libexec/support/analyzeHeadless"
stage=$(mktemp -d "$project/lift.XXXXXX")
# Ghidra rejects project path components starting with a dot (e.g. .t3).
alias_dir=$(mktemp -d /tmp/smr-ghidra.XXXXXX)
ln -s "$project" "$alias_dir/project"
trap 'rm -rf "$stage" "$alias_dir"' EXIT
entries=()
if [[ -f "config/$name-entries.txt" ]]; then
    entries=(.text "$PWD/config/$name-entries.txt")
fi
"$headless" "$alias_dir/project" "$name" -import "$dll" -overwrite -max-cpu 2 \
    -scriptPath "$PWD/tools/ghidra/scripts" -postScript ResolveJumpTables.java \
    -postScript FixNoReturn.java -postScript FixEntries.java "$stage" "${entries[@]}" \
    -postScript DumpPcode.java "$stage/functions.jsonl" all
"$python" vendor/recompiler/recomp/emit.py "$stage/functions.jsonl" "$stage/generated" \
    --external-flags --extra "$stage/extra_entries.json"
printf '%s %s\n' "$(basename "$2")" "$3" > "$stage/generated/lifted-dll"
mv "$stage"/functions.jsonl* "$stage/extra_entries.json" "$project/"
[[ ! -e "$output" ]] || mv "$output" "$stage/previous"
mv "$stage/generated" "$output"
