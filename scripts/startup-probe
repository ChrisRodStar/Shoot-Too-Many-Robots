#!/bin/bash
set -euo pipefail
project="$(cd "$(dirname "$0")/.." && pwd)"
work="$project/work"
data="${SMR_DATA_ROOT:-$work}"
runtime="$project/vendor/macos-runtime"
local_host="$project/src/host"
boot="$work/boot"
logs="$project/logs"
mkdir -p "$logs"
release=0
if [[ "${SMR_RELEASE:-0}" == 1 ]]; then
    release=1
fi
native=0
if [[ "${SMR_NATIVE:-0}" == 1 ]]; then
    native=1
fi
for arg in "$@"; do
    case "$arg" in
        --release) release=1 ;;
        --native) native=1 ;;
        -h|--help) printf 'usage: startup-probe [--release] [--native]\n'; exit 0 ;;
        *) printf 'startup-probe: unknown option %s\n' "$arg" >&2; exit 2 ;;
    esac
done
python="$project/.venv/bin/python"
generated="$work/smr-entry-generated"
variant=""
if [[ "${SMR_FULL:-0}" == 1 ]]; then
    generated="$work/smr-generated"
    variant="-full"
fi
# Release builds get their own host/cache/log paths so a dev run never reloads them.
flavor="$variant"
if [[ "$release" == 1 ]]; then
    flavor="${flavor}-release"
fi

for input in "$generated/table.c" "$boot/ShootManyRobots.exe" "$runtime/tools/startup_build.py"; do
    if [[ ! -f "$input" ]]; then
        printf 'Missing probe input: %s\n' "$input" >&2
        exit 2
    fi
done

unicorn_prefix=""
if [[ "$native" == 0 ]]; then
    unicorn_prefix="$("$python" -c 'import pathlib, unicorn; print(pathlib.Path(unicorn.__file__).parent)')"
fi
build_out="$work/startup-host"
build_flags=(--jobs "${SMR_BUILD_JOBS:-4}")
if [[ -n "$variant" ]]; then
    for marker in "$work"/*-generated/lifted-dll; do
        [[ ! -f "$marker" ]] || build_flags+=(--extra-generated "${marker%/*}")
    done
fi
if [[ "$release" == 1 ]]; then
    build_flags+=(--release)
fi
if [[ -n "$variant" && "${SMR_NATIVE_WNDPROC:-1}" != 1 ]]; then
    # The old native version of this function re-entered Unicorn mid-function because its switch
    # table was unresolved. ResolveJumpTables fixes that; set SMR_NATIVE_WNDPROC=1 to use native code.
    build_flags+=(--interpret-entry 0x5c88f0)
fi
if [[ "${SMR_WINDOW:-0}" == 1 ]]; then
    build_out="$work/window-host"
    build_flags+=(--metal-surface "$local_host/surface.m" --windowed)
    unset FNV_HEADLESS
    mkdir -p "$boot/window${flavor}-frames"
    export FNV_DUMP_FRAMES="${FNV_DUMP_FRAMES:-1,60,120,300}" FNV_DUMP_DIR="$boot/window${flavor}-frames"
elif [[ "${SMR_METAL:-0}" == 1 ]]; then
    build_out="$work/metal-host"
    build_flags+=(--metal-surface "$local_host/offscreen.m")
    export FNV_HEADLESS=1 FNV_DUMP_FRAMES=1 FNV_DUMP_DIR="$boot"
    if [[ -n "$variant" ]]; then
        export FNV_DUMP_DIR="$boot/metal${flavor}-frames"
        mkdir -p "$FNV_DUMP_DIR"
    fi
fi
build_out="${build_out}${flavor}"
if [[ "$native" == 1 ]]; then
    host_bin="$build_out/fnv-startup"
else
    host_bin="$build_out/fnv-discovery"
fi
build_log="$logs/startup${flavor}-build.log"
if [[ "${SMR_SKIP_BUILD:-0}" == 1 ]]; then
    # Reuse the existing host (scripts/recomp builds once, then launches separately).
    if [[ ! -x "$host_bin" ]]; then
        printf 'No existing build at %s (run without SMR_SKIP_BUILD)\n' "$host_bin" >&2
        exit 2
    fi
else
    build_cmd=("$python" "$runtime/tools/startup_build.py" "${build_flags[@]}"
        --local-host "$local_host"
        --generated "$generated"
        --out "$build_out" --cache "$work/startup${flavor}-cache")
    if [[ "$native" == 0 ]]; then
        build_cmd+=(--discovery-prefix "$unicorn_prefix")
    fi
    "${build_cmd[@]}" > "$build_log" 2>&1 || { tail -40 "$build_log" >&2; exit 1; }
fi

if [[ "${SMR_BUILD_ONLY:-0}" == 1 ]]; then
    tail -2 "$build_log"
    exit 0
fi

mkdir -p "$boot/user${flavor}"
cd "$boot"
export SMR_VC90_DIRECTORY="${SMR_VC90_DIRECTORY:-$data/vc90/dlls}"
export SMR_PHYSX_DIRECTORY="${SMR_PHYSX_DIRECTORY:-$data/installed/app/ShootManyRobots/Binaries}"
export SMR_D3DX_DIRECTORY="${SMR_D3DX_DIRECTORY:-$data/d3dx}"
export FNV_USER_DIR="$boot/user${flavor}"
if [[ "${SMR_TRACE:-0}" == 1 ]]; then
    export FNV_TRACE=1
else
    unset FNV_TRACE
fi
if [[ "${SMR_WINDOW:-0}" == 1 || "${SMR_CONTINUE:-0}" == 1 ]]; then
    unset SMR_STOP_AFTER_PRESENT
else
    export SMR_STOP_AFTER_PRESENT=1
fi
export FNV_NO_QOS=1 FNV_ROOT="$data/installed/app/ShootManyRobots"
probe_log="$logs/native${flavor}-startup.log"
if [[ "${SMR_WINDOW:-0}" == 1 ]]; then
    probe_log="$logs/window${flavor}-startup.log"
fi
probe_exit=0
"$python" - "$project" "$boot" "$data" "$host_bin" \
    > "$probe_log" 2>&1 <<'PY_TIMEOUT' || probe_exit=$?
import os
from pathlib import Path
import subprocess
import sys

project, boot, data, host = map(Path, sys.argv[1:])
# Metal's on-disk shader/pipeline cache: the per-user cache directory, resolved because the
# sandbox sees /private/var rather than the /var symlink. The profile grants writes only here.
try:
    base = subprocess.check_output(["getconf", "DARWIN_USER_CACHE_DIR"], text=True).strip()
    metal_cache = os.path.realpath(base + "com.apple.metal")
except Exception:
    metal_cache = str(boot / "metal-cache")
command = [
    "/usr/bin/sandbox-exec",
    "-D", f"USER_HOME={Path.home()}",
    "-D", f"PROJECT={project}",
    "-D", f"BOOT_DIR={boot}",
    "-D", f"DATA_ROOT={data}",
    "-D", f"METAL_CACHE={metal_cache}",
    "-f", str(project / "src/host/startup.sb"),
    str(host), str(boot / "ShootManyRobots.exe"),
]
try:
    result = subprocess.run(command, timeout=None if os.environ.get("SMR_WINDOW") == "1" else int(os.environ.get("SMR_PROBE_SECONDS", "60")))
except subprocess.TimeoutExpired:
    print("[probe] startup exceeded its time limit", file=sys.stderr)
    sys.exit(124)
sys.exit(result.returncode)
PY_TIMEOUT
tail -30 "$probe_log"
exit "$probe_exit"
